generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id        String   @id @default(cuid())
  title     String
  userId    String
  cards     Card[]
  tags      Tag[]    // Board-level tags for reuse
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Card {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  position    Int
  priority    String     @default("medium")
  dueDate     DateTime?
  color       String?    @default("#3b82f6")
  clientEmail String?
  status      String     @default("active")
  
  boardId     String
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId    String
  
  values      CardValue[]
  labels      Label[]
  comments    Comment[]
  cardTags    CardTag[]  // Junction table for many-to-many tags
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([boardId])
  @@index([columnId])
  @@index([status])
  @@index([clientEmail])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#3b82f6")
  
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  
  cardTags  CardTag[]
  
  createdAt DateTime @default(now())

  @@unique([name, boardId]) // Tag names unique per board
  @@index([boardId])
}

model CardTag {
  id        String   @id @default(cuid())
  
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([cardId, tagId]) // Prevent duplicate tags on same card
  @@index([cardId])
  @@index([tagId])
}

model CardValue {
  id            String         @id @default(cuid())
  name          String
  category      String
  currentValue  Float
  targetValue   Float
  unit          String         @default("")
  color         String         @default("#3b82f6")
  
  cardId        String
  card          Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  history       ValueHistory[]
  alerts        ValueAlert[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([cardId])
}

model ValueHistory {
  id          String    @id @default(cuid())
  value       Float
  note        String?
  timestamp   DateTime  @default(now())
  
  valueId     String
  cardValue   CardValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@index([valueId])
  @@index([timestamp])
}

model ValueAlert {
  id              String    @id @default(cuid())
  condition       String
  threshold       Float
  message         String
  active          Boolean   @default(true)
  lastTriggered   DateTime?
  
  valueId         String
  cardValue       CardValue @relation(fields: [valueId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())

  @@index([valueId])
}

model Label {
  id     String @id @default(cuid())
  name   String
  color  String
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}