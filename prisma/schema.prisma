generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id           String   @id @default(uuid())
  title        String
  client_email String?
  status       String   @default("inquiry") // inquiry, quoted, completed, followup
  color        String   @default("#3b82f6")
  tags         String   @default("")         // comma-separated: "Hot,Recurring"
  due_date     String?  // ISO date string
  files        String   @default("[]")       // JSON array of {url, name}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}